        : {};
    cursor[key] = child;
    cursor = child;
  }
  cursor[path[path.length - 1]] = value;
  return clone;
}

function withSchemaVersion<T extends Record<string, unknown>>(
  data: T,
  options: CallOptions | undefined,
  path: readonly string[] | undefined,
  version: string,
  envelopeKey: "properties" | "traits",
