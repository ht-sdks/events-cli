{
  "name": "@ht-sdks/events-cli",
  "version": "0.1.0",
  "description": "Codegen CLI for Hightouch Events",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "htevents": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "pretest": "pnpm run build",
    "test": "jest",
    "generate:schema": "tsx scripts/emit-config-schema.ts",
    "check:schema": "tsx scripts/emit-config-schema.ts --check",
    "test:harness": "tsx scripts/run-harness.ts",
    "test:harness:all": "tsx scripts/run-harness.ts --all"
  },
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "commander": "^13",
    "quicktype-core": "^26.0.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ht-sdks/events-sdk-js-browser": "1.4.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "zod-to-json-schema": "^3.25.2"
  }
}
