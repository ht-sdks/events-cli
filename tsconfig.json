{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "isolatedModules": true,
    "types": ["node", "jest"],
    "outDir": "dist",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "test", "scripts"],
  "exclude": [
    "test/harness/go",
    "test/harness/browser-ts",
    "test/harness/swift",
    "test/harness/react-native"
  ]
}
